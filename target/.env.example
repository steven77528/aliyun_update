RUN_MODE=loop
# RUN_MODE=once

BASE_CONFIG_FILE=./config/base.json
CLOUD_CONFIG_FILE=./config/cloud.yaml
NOTIFY_CONFIG_FILE=./config/notify.json

STATE_FILE=./data/ip_sync_state.json
ALERT_STATE_FILE=./data/ip_sync_alert_state.json
LOCK_FILE=./data/ip_sync.lock

REQUEST_TIMEOUT_SECONDS=6
RETRY_COUNT=2
RETRY_BACKOFF_SECONDS=1.0
ALERT_WEBHOOK_URL=
ALERT_RATE_LIMIT_SECONDS=300

LOG_DIR=/app/logs
LOG_RETENTION_DAYS=7
