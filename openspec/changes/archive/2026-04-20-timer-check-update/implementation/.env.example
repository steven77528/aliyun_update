# ===== 运行模式 =====
RUN_MODE=once
CHECK_INTERVAL_SECONDS=3600

# ===== 单账号兼容配置（二选一：单账号 或 ACCOUNTS） =====
ALIYUN_REGION=cn-hangzhou
SECURITY_GROUP_ID=sg-xxxxxxxx
RULE_IDENTIFIER=sgr-xxxxxxxx
ACCESS_KEY_ID=
ACCESS_KEY_SECRET=

# ===== 单账号多目标（可选，替代 SECURITY_GROUP_ID/RULE_IDENTIFIER） =====
# SECURITY_GROUPS=[{"security_group_id":"sg-1","rule_identifier":"sgr-1"},{"security_group_id":"sg-2","rule_identifier":"sgr-2"}]

# ===== 多账号配置（可选，优先级高于单账号） =====
# ACCOUNTS=[{"name":"acc-a","region_id":"cn-hangzhou","access_key_id":"id","access_key_secret":"secret","security_groups":[{"security_group_id":"sg-1","rule_identifier":"sgr-1"}]},{"name":"acc-b","region_id":"cn-shanghai","access_key_id":"id2","access_key_secret":"secret2","security_groups":[{"security_group_id":"sg-2","rule_identifier":"sgr-2"}]}]

# ===== 可选（建议保留多源） =====
IP_SOURCES=https://api64.ipify.org,https://ifconfig.me/ip,https://checkip.amazonaws.com
STATE_FILE=./.ip_sync_state.json
ALERT_STATE_FILE=./.ip_sync_alert_state.json
LOCK_FILE=./.ip_sync.lock
REQUEST_TIMEOUT_SECONDS=6
RETRY_COUNT=2
RETRY_BACKOFF_SECONDS=1.0
ALERT_WEBHOOK_URL=
ALERT_RATE_LIMIT_SECONDS=300
